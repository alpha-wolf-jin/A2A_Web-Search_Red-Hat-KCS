# =============================================================================
# Research Concierge — environment variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# All values shown here are the defaults used when a variable is not set.
#
# Start order:
#   1.  ./web-search-agent-deepseek.py   (leaf: web search,  port 8080)
#   2.  ./redhat-kcs-agent-deepseek.py   (leaf: Red Hat KCS, port 8081)
#   3.  ./a2a_web_server.py              (concierge,         port 9996)
#   4.  uv run web_UI.py                 (Flask UI,          port 5002)
# =============================================================================


# -----------------------------------------------------------------------------
# API keys  (REQUIRED — no defaults)
# -----------------------------------------------------------------------------

# DeepSeek API key — used by every component that calls the LLM.
#DEEPSEEK_API_KEY=sk-...

# Red Hat offline token — only required for redhat-kcs-agent-deepseek.py.
# Obtain at: https://access.redhat.com/management/api
#REDHAT_OFFLINE_TOKEN=your_offline_token_here


# -----------------------------------------------------------------------------
# Model selection
# -----------------------------------------------------------------------------

# Model used by the leaf agents (web search and Red Hat KCS).
# deepseek-v4-flash  — fast, lower cost   (default)
# deepseek-chat      — classic chat model
DEEPSEEK_MODEL=deepseek-v4-flash

# Model used by the concierge orchestrator.
# Overrides DEEPSEEK_MODEL for the concierge only.
# deepseek-v4-pro    — default (better routing/reasoning)
# deepseek-v4-flash  — faster, lower cost
# NOTE: deepseek-reasoner is NOT compatible with tool_choice forcing used
#       by the concierge and will be rejected at startup.
CONCIERGE_DEEPSEEK_MODEL=deepseek-v4-flash


# -----------------------------------------------------------------------------
# Thinking mode  (DeepSeek V4 chain-of-thought toggle)
# -----------------------------------------------------------------------------
# Accepted values: disabled | enabled   (or: 0/1, false/true, off/on, no/yes)
#
# CONCIERGE: one strategic routing decision per request — thinking MIGHT help,
#   but forced tool_choice + thinking has known DeepSeek compatibility issues.
#   Leave disabled unless experimenting.
#
# LEAF AGENTS: tight tool-calling loops — thinking is HARMFUL here.
#   It causes 3-4× parallel tool calls per LLM round, inflating search rounds
#   from the intended ≤5 up to 15-18, and bloating the context returned to
#   the concierge.  Always keep disabled for leaf agents.

CONCIERGE_DEEPSEEK_THINKING=disabled
WEB_SEARCH_DEEPSEEK_THINKING=disabled
KCS_DEEPSEEK_THINKING=disabled


# -----------------------------------------------------------------------------
# Network — host and ports
# -----------------------------------------------------------------------------

# Hostname that all agents bind to and use to find each other.
AGENT_HOST=localhost

# Web search leaf agent  (web-search-agent-deepseek.py)
WEB_SEARCH_AGENT_PORT=8080

# Red Hat KCS leaf agent  (redhat-kcs-agent-deepseek.py)
REDHAT_KCS_AGENT_PORT=8081

# Concierge A2A server  (a2a_web_server.py / web_util.py serve mode)
# Note: a2a_web_server.py reads  Concierge_AGENT_PORT
#       web_util.py serve mode reads HEALTHCARE_AGENT_PORT
# Both default to 9996; set both if you change the port.
Concierge_AGENT_PORT=9996
HEALTHCARE_AGENT_PORT=9996

# Flask UI  (web_UI.py)
UI_HOST=0.0.0.0
UI_PORT=5002
FLASK_DEBUG=false


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Directory where JSONL log files are written (one sub-dir per UTC date).
# Default: ./logs   (relative to the working directory when the process starts)
# CONCIERGE_LOG_DIR=/var/log/concierge
